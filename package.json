    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build && node scripts/postbuild.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
