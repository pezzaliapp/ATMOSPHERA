{
  "name": "atmosphera",
  "version": "0.3.0-beta",
  "private": true,
  "description": "ATMOSPHERA — globo meteorologico 3D, PWA statica dell'ecosistema PezzaliAPP.",
  "author": "Alessandro Pezzali",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pezzaliapp/ATMOSPHERA.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
